{
  "$schema": "../schemas/scenario-v1.schema.json",
  "version": 1,
  "name": "Log in and view a protected page",
  "variables": {
    "base_url": "http://127.0.0.1:8080",
    "username": "grunt",
    "password": "zugzug"
  },
  "steps": [
    {
      "name": "Open login form",
      "url": "{{base_url}}/login"
    },
    {
      "name": "Submit credentials",
      "url": "{{base_url}}/login",
      "method": "POST",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": "username={{username}}&password={{password}}",
      "wait_ms": 300
    },
    {
      "name": "View protected page",
      "url": "{{base_url}}/protected",
      "wait_ms": 300
    }
  ]
}
