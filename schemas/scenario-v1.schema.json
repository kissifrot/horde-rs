{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horde scenario version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "\\S" },
    "variables": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "allOf": [
          { "not": { "required": ["body", "form"] } },
          { "not": { "required": ["body", "json_body"] } },
          { "not": { "required": ["form", "json_body"] } }
        ],
        "properties": {
          "name": { "type": "string", "pattern": "\\S" },
          "url": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1, "default": "GET" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "body": { "type": ["string", "null"] },
          "form": { "type": "object", "additionalProperties": { "type": "string" } },
          "json_body": { "type": ["object", "array"] },
          "wait_ms": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615, "default": 0 },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "status": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
              "final_url": { "type": "string", "minLength": 1 },
              "headers": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
              "body_contains": { "type": "string", "minLength": 1 }
            }
          },
          "extract": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
            "additionalProperties": {
              "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["from", "name"], "properties": { "from": { "const": "header" }, "name": { "type": "string", "minLength": 1 } } },
                { "type": "object", "additionalProperties": false, "required": ["from", "pointer"], "properties": { "from": { "const": "json" }, "pointer": { "type": "string" } } },
                { "type": "object", "additionalProperties": false, "required": ["from", "selector", "attribute"], "properties": { "from": { "const": "html" }, "selector": { "type": "string", "minLength": 1 }, "attribute": { "type": "string", "minLength": 1 } } }
              ]
            }
          }
        }
      }
    }
  }
}
